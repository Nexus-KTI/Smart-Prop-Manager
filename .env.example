SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_KEY=
# Required for Paystack webhooks and receipt PDF uploads to Storage
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed into /admin (union with public.admin_allowlist)
ADMIN_EMAILS=
# Production web origin(s) for CORS + invite links
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Cron auth for POST /reminders/jobs/due
CRON_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp From — use a production sender, not the sandbox, for real NG delivery
TWILIO_WHATSAPP_FROM=
# SMS From number or Messaging Service SID (e.g. +14472244801)
TWILIO_SMS_FROM=
# Optional error tracking (API)
SENTRY_DSN=
# Email channel for reminders/receipts (Mailgun preferred, or SMTP)
EMAIL_SERVICE_PROVIDER=mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE_URL=https://api.mailgun.net
MAILGUN_SENDER_EMAIL=
EMAIL_FROM_NAME=Smart Prop
# Phase 3: tenancy document upload (default off until ToS/DPA)
DOCS_UPLOAD_ENABLED=false
# Optional public logo URL for email header (wordmark used when empty)
EMAIL_LOGO_URL=
FROM_EMAIL=
# Optional SMTP fallback when Mailgun is unset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
