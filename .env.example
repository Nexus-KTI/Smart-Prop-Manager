SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_KEY=
# Required for Paystack webhooks and receipt PDF uploads to Storage
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed into /admin (union with public.admin_allowlist)
ADMIN_EMAILS=
# Production web origin(s) for CORS + invite links
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Cron auth for POST /reminders/jobs/due
CRON_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp From — use a production sender, not the sandbox, for real NG delivery
TWILIO_WHATSAPP_FROM=
# SMS From number or Messaging Service SID (e.g. +14472244801)
TWILIO_SMS_FROM=
# Shared secret for OTP SMS delivery diagnostics (Next.js /api proxy → API).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Set the same value in web/.env.local and the API .env. Leave empty to disable.
NOTIFY_DIAG_SECRET=
# Public Cloudflare Turnstile site key (web + Supabase Auth UI).
# Also configure Turnstile as the CAPTCHA provider in Supabase Auth.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-side Turnstile secret — when set, POST /public/leads requires a valid token.
# Keep this API-only; never prefix it with NEXT_PUBLIC_.
# TURNSTILE_SECRET_KEY=
# Behind Cloudflare / Render: trust CF-Connecting-IP (then first X-Forwarded-For hop) for rate limits
# TRUST_PROXY=1
# Optional error tracking (API)
SENTRY_DSN=
# Email channel for reminders/receipts (Mailgun preferred, or SMTP)
EMAIL_SERVICE_PROVIDER=mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE_URL=https://api.mailgun.net
MAILGUN_SENDER_EMAIL=
EMAIL_FROM_NAME=Smart Prop
# Tenancy documents: server-only kill switches. Keep false until legal/security
# launch gate is approved and the private tenancy-docs bucket is provisioned.
DOCS_READ_ENABLED=false
DOCS_UPLOAD_ENABLED=false
# Agreement/reference request, claimed-tenant submission, and review gates.
DOC_REQUESTS_ENABLED=false
TENANT_DOC_SUBMISSIONS_ENABLED=false
DOC_REVIEW_ENABLED=false
PRIVACY_CASES_ENABLED=false
# Private ClamAV daemon required before writes can succeed.
DOCS_CLAMAV_HOST=
DOCS_CLAMAV_PORT=3310
# Counsel-approved receipt/read wording version; leave blank before approval.
DOCS_ACK_TEXT_VERSION=
# Separate destructive gate for the retention operator command.
DOCS_RETENTION_PURGE_ENABLED=false
# Optional public logo URL for email header (wordmark used when empty)
EMAIL_LOGO_URL=
FROM_EMAIL=
# Optional SMTP fallback when Mailgun is unset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
